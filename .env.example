# Event Ticketing System - Environment variables
# Copy to .env in the project root (eventTrackingSystem/) and adjust if needed.
# Required for the app to connect to MySQL. Mongo and Redis have defaults.

# Server
SERVER_PORT=8080

# MySQL (must match docker-compose or your local MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=ticketdb
MYSQL_USER=ticketing
MYSQL_PASSWORD=ticketing

# MongoDB (defaults work with docker-compose)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ticketdb

# Redis (default works with docker-compose)
REDIS_URI=redis://localhost:6379

# JWT (use a strong secret in production)
JWT_SECRET=change-me-in-production

# Comma-separated emails that get admin role on login (e.g. for POST /events)
ADMIN_EMAILS=admin@example.com
